    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    body {
      background-color: #f7fafc;
      color: #2d3748;
      line-height: 1.5;
    }

    /* Шапка (Header) */
    .header {
      background: #ffffff;
      border-bottom: 1px solid #e2e8f0;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-container {
      max-width: 1140px;
      margin: 0 auto;
      padding: 16px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .logo-icon-placeholder {
      width: 40px;
      height: 40px;
      background-color: #3182ce;
      border-radius: 50%;
    }

    .logo-title {
      display: block;
      font-weight: 700;
      font-size: 16px;
      color: #1a202c;
    }

    .logo-subtitle {
      display: block;
      font-size: 12px;
      color: #718096;
    }

    .nav {
      display: flex;
      gap: 24px;
    }

    .nav-link {
      text-decoration: none;
      color: #4a5568;
      font-size: 14px;
      font-weight: 500;
      padding: 6px 12px;
      border-radius: 20px;
    }

    .nav-link.active, .nav-link:hover {
      background-color: #ebf8ff;
      color: #2b6cb0;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .icon-btn {
      background: none;
      border: none;
      font-size: 18px;
      cursor: pointer;
    }

    /* Кнопки */
    .btn {
      padding: 10px 20px;
      border-radius: 24px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      border: none;
    }

    .btn-primary {
      background-color: #3182ce;
      color: #ffffff;
    }

    .btn-primary:hover {
      background-color: #2b6cb0;
    }

    .btn-outline {
      background-color: #ebf8ff;
      color: #2b6cb0;
      border: 1px solid #bee3f8;
    }

    /* Hero Section */
    .hero {
      padding: 60px 20px;
      background: #ffffff;
    }

    .hero-container {
      max-width: 1140px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 40px;
    }

    .hero-content {
      flex: 1;
    }

    .hero-title {
      font-size: 38px;
      font-weight: 800;
      line-height: 1.2;
      color: #1a202c;
      margin-bottom: 16px;
    }

    .highlight {
      color: #3182ce;
    }

    .hero-description {
      font-size: 16px;
      color: #4a5568;
      margin-bottom: 24px;
      max-width: 480px;
    }

    .hero-image-placeholder {
      flex: 1;
      height: 300px;
      border: 2px dashed #cbd5e0;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #a0aec0;
      background: #f7fafc;
    }

    /* Topics Section */
    .topics-section {
      max-width: 1140px;
      margin: 60px auto;
      padding: 0 20px;
      text-align: center;
    }

    .section-badge {
      display: inline-block;
      font-size: 12px;
      font-weight: 700;
      color: #3182ce;
      letter-spacing: 1px;
      margin-bottom: 8px;
    }

    .section-title {
      font-size: 26px;
      color: #1a202c;
      margin-bottom: 40px;
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 24px;
      display: flex;
      align-items: center;
      gap: 20px;
      text-align: left;
    }

    .card-media-placeholder {
      width: 120px;
      height: 90px;
      border: 1px dashed #cbd5e0;
      border-radius: 8px;
      background: #edf2f7;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      color: #a0aec0;
      flex-shrink: 0;
    }

    .card-content h3 {
      font-size: 18px;
      color: #2d3748;
      margin-bottom: 6px;
    }

    .card-content p {
      font-size: 13px;
      color: #718096;
      margin-bottom: 12px;
    }

    .card-link {
      color: #3182ce;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
    }

    /* Features Section */
    .features-section {
      background: #ffffff;
      border-top: 1px solid #e2e8f0;
      padding: 40px 20px;
    }

    .features-grid {
      max-width: 1140px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
    }

    .feature-item {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .feature-icon-placeholder {
      font-size: 24px;
      width: 48px;
      height: 48px;
      background: #ebf8ff;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .feature-item h4 {
      font-size: 15px;
      color: #2d3748;
    }

    .feature-item p {
      font-size: 13px;
      color: #718096;
    }

    /* Footer */
    .footer {
      background: #2d3748;
      color: #a0aec0;
      text-align: center;
      padding: 20px;
      font-size: 14px;
    }

    /* Адаптивность */
    @media (max-width: 900px) {
      .hero-container {
        flex-direction: column;
      }
      .cards-grid, .features-grid {
        grid-template-columns: 1fr;
      }
      .nav {
        display: none;
      }
    }
